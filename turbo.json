{
    "$schema": "https://turborepo.com/schema.json",
    "tasks": {
        "prisma:generate": {
            "cache": true,
            "outputs": [
                "generated/**"
            ]
        },
        "build": {
            "dependsOn": [
                "^build",
                "prisma:generate"
            ],
            "outputs": [
                ".next/**",
                "!.next/cache/**",
                "dist/**"
            ]
        },
        "check-types": {
            "dependsOn": [
                "^check-types"
            ]
        },
        "dev": {
            "persistent": true,
            "cache": false,
            "dependsOn": [
                "prisma:generate"
            ]
        }
    }
}